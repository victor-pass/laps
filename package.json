{
  "name": "lap-tracker",
  "version": "0.1",
  "description": "Track laps using QR codes",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "build": "vite build && $npm_execpath run build:pwa",
    "build:pwa": "tsx build/generate-service-worker.ts",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "keywords": [
    "qr code",
    "lap tracker",
    "pwa"
  ],
  "author": "Stephen Smithwick",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.12.1",
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.4.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/browser-playwright": "^4.1.11",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.10.0",
    "eslint-plugin-solid": "^0.18.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vite-ssr-components": "^0.6.1",
    "vitest": "^4.1.11",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/oauth-providers": "^0.9.0",
    "@neondatabase/serverless": "^1.1.0",
    "@solidjs/router": "^1.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.5",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "solid-js": "^1.9.15"
  }
}
